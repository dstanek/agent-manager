FROM alpine:3.24

RUN apk add --no-cache \
    bash \
    ca-certificates \
    curl \
    git \
    github-cli \
    nodejs \
    npm

# Install GitHub Copilot CLI
RUN npm install -g @github/copilot

# Create a non-root user so agents can run without elevated privileges
RUN addgroup -g 1000 am \
 && adduser -D -u 1000 -G am -s /bin/bash am \
 && mkdir -p /home/am/.config /workspace \
 && chown -R am:am /home/am/.config /workspace

USER am
ENV HOME=/home/am

# ~/.config/gh and ~/.config/github-copilot will be mounted read-only by `am` at runtime
WORKDIR /workspace
